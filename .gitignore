# Secrets
.env
.env.local
*.pem
*.key

# Build
/bin/
*.exe
*.test

# Frontend
/web/node_modules/
node_modules
# The bundle is embedded into the binary; the directory itself must exist for //go:embed
# to compile in a fresh clone, so the placeholder is tracked and the output is not.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Local proxy configuration written on the server by install.sh. Not tracked on purpose: an
# update rewrites tracked files, and what a deployment adds here has to survive that.
/caddy.d/

# Profile
coverage.out
coverage.html
*.prof

# IDE
.idea/
.vscode/
.DS_Store

# Local environment template: make env copies it to .env.
# Variables override configs/config.yaml, the name is built from the key path: http.port -> SHELF_HTTP_PORT.

SHELF_APP_ENV=local
SHELF_HTTP_PORT=8080

SHELF_POSTGRES_HOST=localhost
SHELF_POSTGRES_PORT=5432
SHELF_POSTGRES_USER=postgres
SHELF_POSTGRES_PASSWORD=postgres
SHELF_POSTGRES_DATABASE=shelf
SHELF_POSTGRES_SSL_MODE=disable
# The migrations are built into the binary and applied on startup. Set to false only where
# something else owns the schema.
SHELF_POSTGRES_AUTO_MIGRATE=true

# Signs access and recovery tokens, at least 32 characters.
# Generate with: openssl rand -hex 32
# Required in every environment except local: locally an empty value makes the service
# generate an ephemeral secret, so issued tokens stop working after a restart.
SHELF_AUTH_SECRET=

# Rate limiting for login and recovery/start. Thresholds live in configs/config.yaml,
# an individual value is overridden like this: SHELF_AUTH_RATE_LIMIT_LOGIN_IP_LIMIT=10
SHELF_AUTH_RATE_LIMIT_ENABLED=true

# The Claude connector. Off by default; both values are required when it is on.
# Generate the secret with: openssl rand -hex 32
SHELF_MCP_ENABLED=false
SHELF_MCP_SECRET=
SHELF_MCP_PUBLIC_BASE_URL=

SHELF_LOG_LEVEL=debug
SHELF_LOG_FORMAT=console
